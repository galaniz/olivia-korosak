{
  "name": "olivia-korosak",
  "main": "./src/workers/Site/SiteWorker.ts",
  "compatibility_date": "2026-04-26",
  "workers_dev": false,
  "preview_urls": true,
  "minify": true,
  "kv_namespaces": [
    {
      "binding": "SITE_KV",
      "id": "e7aaa78c1e944e5bae8126bedd908414"
    }
  ],
  "assets": {
    "directory": "./site/",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.02
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CTFL_PRODUCTION_HOST": "cdn.contentful.com"
  },
  "secrets": {
    "required": [
      "CTFL_SPACE_ID",
      "CTFL_PRODUCTION_TOKEN"
    ]
  },
  "env": {
    "preview": {
      "main": "./src/workers/Preview/PreviewWorker.ts",
      "preview_urls": false,
      "workers_dev": false,
      "minify": true,
      "vars": {
        "ENVIRONMENT": "development",
        "CTFL_PRODUCTION_HOST": "cdn.contentful.com",
        "CTFL_DEVELOPMENT_HOST": "preview.contentful.com"
      },
      "secrets": {
        "required": [
          "CTFL_SPACE_ID",
          "CTFL_DEVELOPMENT_TOKEN"
        ]
      },
      "kv_namespaces": [
        {
          "binding": "SITE_KV",
          "id": "7cff93c48bc343d4b1abb24bfec5e95a"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    },
    "staging": {
      "main": "./src/workers/Staging/StagingWorker.ts",
      "preview_urls": false,
      "workers_dev": false,
      "minify": true,
      "vars": {
        "ENVIRONMENT": "development",
        "CTFL_ENV": "staging",
        "CTFL_PRODUCTION_HOST": "cdn.contentful.com",
        "CTFL_DEVELOPMENT_HOST": "preview.contentful.com"
      },
      "secrets": {
        "required": [
          "CTFL_SPACE_ID",
          "CTFL_DEVELOPMENT_TOKEN"
        ]
      },
      "kv_namespaces": [
        {
          "binding": "SITE_KV",
          "id": "7cff93c48bc343d4b1abb24bfec5e95a"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
