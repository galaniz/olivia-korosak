{
  "name": "olivia-korosak",
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "scripts": {
    "build:client": "npx tsc --project tsconfig.client.json",
    "build:node": "npx tsc --project tsconfig.node.json",
    "build": "pnpm build:client && pnpm build:node && node lib/esbuild/esbuild.js --site",
    "watch:client": "npx tsc --watch --preserveWatchOutput --project tsconfig.client.json",
    "watch:node": "npx tsc --watch --preserveWatchOutput --project tsconfig.node.json",
    "watch:esbuild": "node scripts/watch.js",
    "start": "npm-run-all --parallel watch:node watch:client watch:esbuild",
    "lint:ts": "npx eslint .",
    "lint:scss": "stylelint 'src/**/*.scss'",
    "lint": "pnpm lint:ts && pnpm lint:scss",
    "typecheck:client": "npx tsc --noEmit --project tsconfig.client.json",
    "typecheck:node": "npx tsc --noEmit --project tsconfig.node.json",
    "typecheck:workers": "npx tsc --noEmit --project src/workers/tsconfig.json",
    "typecheck": "pnpm typecheck:client && pnpm typecheck:node && pnpm typecheck:workers",
    "types": "node scripts/types.js",
    "types:check": "node scripts/types.js --check",
    "wrangler:contact": "npx wrangler dev --config src/workers/Contact/wrangler.jsonc",
    "wrangler:site": "npx wrangler dev --config wrangler.jsonc",
    "wrangler:preview": "npx wrangler dev --config wrangler.jsonc --env preview",
    "wrangler:staging": "npx wrangler dev --config wrangler.jsonc --env staging",
    "clean": "rm -rf node_modules/.cache/tsbuildinfo.* || true && rm -rf .cache || true && rm -rf site || true && rm -rf lib || true"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@alanizcreative/formation": "0.0.5",
    "@alanizcreative/formation-static": "0.0.8",
    "@contentful/live-preview": "4.10.26",
    "@esbuild/linux-x64": "0.28.2",
    "@fullhuman/postcss-purgecss": "8.0.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.3",
    "@types/validator": "13.15.10",
    "autoprefixer": "^10.6.1",
    "contentful-resolve-response": "2.0.1",
    "dotenv": "^18.0.4",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.28",
    "postcss-modules": "^9.0.1",
    "sass": "^1.105.0",
    "stripe": "22.6.2",
    "typescript": "^6.0.3",
    "uuid": "^14.0.2",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript-eslint": "8.70.1"
  },
  "optionalDependencies": {
    "@types/safe-json-stringify": "^1.1.5",
    "keyv": "5.6.0",
    "keyv-file": "5.3.5",
    "nodemon": "3.1.14",
    "npm-run-all": "^4.1.5",
    "safe-json-stringify": "^1.2.0",
    "wrangler": "^4.142.0"
  },
  "browserslist": [
    "> 0.5%"
  ]
}
